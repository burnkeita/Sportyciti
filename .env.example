APP_NAME=SportyCiti
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sportyciti
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=
# Production: CACHE_STORE=redis, QUEUE_CONNECTION=redis, SESSION_DRIVER=redis (predis client, no PHP extension needed)

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="newsroom@sportyciti.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# SportyCiti
# ---------------------------------------------------------------------------
# First Super Administrator (created by `php artisan db:seed` if the email does not exist).
# Leave the password empty to generate a random one that is printed once.
SUPER_ADMIN_NAME="SportyCiti Admin"
SUPER_ADMIN_EMAIL=admin@sportyciti.com
SUPER_ADMIN_PASSWORD=

# Require authenticator-app 2FA for admin staff (defaults to true when APP_ENV=production).
STAFF_MFA_REQUIRED=

# Comma-separated proxy IPs/CIDRs in front of the app (load balancer, Cloudflare), or * to trust all.
TRUSTED_PROXIES=

# Football data provider: api_football | demo
SPORTS_DATA_PROVIDER=api_football
# Fall back to clearly-labelled fictional demo data when no API key is set. Defaults to on outside production.
SPORTS_DATA_DEMO_FALLBACK=
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
# Requests per minute allowed by your API-Football plan (Free 10, Pro 300, Ultra 450, Mega 900).
API_FOOTBALL_RPM=10
API_FOOTBALL_QUOTA_RESERVE=5
SPORTS_SYNC_DAYS_AHEAD=3
SPORTS_SYNC_DAYS_BEHIND=1

# Backups (spatie/laravel-backup). Use an off-site disk such as s3 in production: BACKUP_DISKS=s3
BACKUP_DISKS=local
# Directory containing mysqldump if it is not on PATH (XAMPP: C:/xampp/mysql/bin/)
DB_DUMP_BINARY_PATH=
BACKUP_NOTIFICATION_EMAIL=tech@sportyciti.com
BACKUP_ARCHIVE_PASSWORD=
